```gitignore
# ==========================================
# Dependencies
# ==========================================
node_modules/
.pnp/
.pnp.js

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
!.env.sample

# ==========================================
# Build Output
# ==========================================
dist/
build/
out/
.next/
.nuxt/
.output/
coverage/

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==========================================
# IDEs & Editors
# ==========================================
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Uncomment if you want to share VS Code settings
# !.vscode/settings.json
# !.vscode/extensions.json

# ==========================================
# Temporary Files
# ==========================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.old
*.orig

# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
dist-python/
wheels/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.venv/
venv/
env/
ENV/
htmlcov/
.ipynb_checkpoints/

# ==========================================
# Databases & Local Data
# ==========================================
*.sqlite
*.sqlite3
*.db
data/
local-data/

# ==========================================
# Frontend Frameworks & Tools
# ==========================================
.vite/
.svelte-kit/
.angular/
.parcel-cache/
.turbo/
.vercel/
.netlify/

# ==========================================
# Testing
# ==========================================
.nyc_output/
playwright-report/
test-results/

# ==========================================
# Package Manager & Tool Caches
# ==========================================
.npm/
.eslintcache
.stylelintcache
.cache/

# ==========================================
# Java & Build Tools
# ==========================================
*.class
*.jar
*.war
target/
.gradle/
.idea/

# ==========================================
# C / C++ Build Files
# ==========================================
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.out
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# ==========================================
# Archives & Large Files
# ==========================================
*.zip
*.rar
*.7z
*.tar
*.gz

# ==========================================
# OS / Package Artifacts
# ==========================================
npm-shrinkwrap.json.bak
```
